{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (g++)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-I${workspaceFolder}/include",
        "src/main.cpp",
        "src/glad.c",
        "src/stb_image.cpp",
        "src/tiny_obj_loader.cpp",
        "src/textrendering.cpp",
        "-L${workspaceFolder}/lib-mingw-64",
        "-lglfw3",
        "-lopengl32",
        "-lgdi32",
        "-o",
        "${workspaceFolder}/bin/Debug/main_g++.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build (CMake)",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--config", "Debug"],
      "group": "build",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": ["$msCompile"]
    }
  ]
}
